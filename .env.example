# OKX API Credentials
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here
OKX_SANDBOX=false

# Telegram Bot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Web Dashboard
# Bind adresi: 127.0.0.1 (sadece lokal) veya 0.0.0.0 (uzak erişim - firewall kontrol edin)
WEB_HOST=127.0.0.1
WEB_PORT=8080
# WEB_SECRET_KEY: Production için güçlü random bir değer verin (ör. 32+ karakter hex).
WEB_SECRET_KEY=change_this_to_a_random_secret
# WEB_AUTH_ENABLED: Default true. Sadece lokal dev için false yapılabilir.
# true + boş WEB_SECRET_KEY kombinasyonunda auth zorunlu olmaya devam eder
# ama istek yapılamaz (secret set etmeyi unutmayın).
WEB_AUTH_ENABLED=true
# CORS: Virgülle ayrılmış origin listesi. Boş = default (localhost).
# Production için sadece ihtiyacınız olan origin'leri ekleyin.
# WEB_CORS_ORIGINS=https://your-dashboard.example.com
